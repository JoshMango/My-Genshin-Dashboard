# Public contact URL used in the Enka User-Agent.
ENKA_CONTACT_URL=https://github.com/JoshMango/My-Genshin-Dashboard/issues
# Required on Vercel unless the Marketplace supplies KV_REST_API_URL and KV_REST_API_TOKEN.
# Leave both blank for the local in-memory cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
